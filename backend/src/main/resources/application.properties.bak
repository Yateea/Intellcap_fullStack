spring.application.name=intellcap-backend
spring.docker.compose.enabled=false

spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5435/intellcap_db}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:intellcap_user}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:intellcap_pass}
spring.datasource.driver-class-name=org.postgresql.Driver
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME:contact@intellcap.fr}
spring.mail.password=${MAIL_PASSWORD:votre_mot_de_passe_app}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.open-in-view=false

spring.data.redis.host=${SPRING_DATA_REDIS_HOST:localhost}
spring.data.redis.port=${SPRING_DATA_REDIS_PORT:6379}

server.port=8888

jwt.secret=${JWT_SECRET:intellcap_super_secret_key_2026_must_be_long_enough}
jwt.expiration=86400000
server.port=8889
