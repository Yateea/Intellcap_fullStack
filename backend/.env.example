# Copiez ce fichier en ".env" en local si besoin (NE JAMAIS committer le vrai .env)
# Sur Railway/Render, ces valeurs se règlent dans l'onglet "Variables", pas dans un fichier.

SPRING_DATASOURCE_URL=jdbc:postgresql://HOTE_POSTGRES:5432/intellcap_db
SPRING_DATASOURCE_USERNAME=intellcap_user
SPRING_DATASOURCE_PASSWORD=changez_moi

SPRING_DATA_REDIS_HOST=HOTE_REDIS
SPRING_DATA_REDIS_PORT=6379

JWT_SECRET=remplacez_par_une_chaine_aleatoire_de_32_caracteres_minimum
JWT_EXPIRATION=86400000

EMAIL_PASSWORD=
RECAPTCHA_SECRET=

PORT=8888
